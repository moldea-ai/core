{
  "name": "@moldea.ai/adapter-static-analysis",
  "version": "0.0.0",
  "description": "Private static-analysis primitives shared by Moldea runtime adapters.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^22.11.0 || ^24.11.0"
  },
  "scripts": {
    "build": "vite build --emptyOutDir && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "semver": "7.8.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/semver": "7.8.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
