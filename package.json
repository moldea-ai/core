{
  "name": "moldea.ai",
  "version": "0.0.0",
  "description": "The monorepo for the first-class packages, shared internals, and private applications that implement and present the open moldea ecosystem.",
  "private": true,
  "homepage": "https://github.com/moldea-ai/packages#readme",
  "bugs": {
    "url": "https://github.com/moldea-ai/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moldea-ai/packages.git"
  },
  "license": "MIT",
  "author": "Jesus Graterol",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^24.15.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "compatibility:check": "node scripts/runtime-compatibility/check.ts",
    "compatibility:generate": "node scripts/runtime-compatibility/generate.ts",
    "docs:check": "pnpm --filter @moldea.ai/packages-website docs:check",
    "docs:generate": "pnpm --filter @moldea.ai/packages-website docs:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:root && turbo run lint",
    "lint:root": "eslint eslint.config.js vitest.config.ts vitest-integration.config.ts configs scripts",
    "release:check-changes": "node scripts/npm-release/check-changes.ts",
    "release:checksums": "node scripts/npm-release/checksums.ts",
    "release:plan": "node scripts/npm-release/plan.ts",
    "release:prepare": "node scripts/npm-release/prepare.ts",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "test:integration": "pnpm test:root:integration && turbo run test:integration",
    "test:root": "pnpm test:root:unit && pnpm test:root:integration",
    "test:root:integration": "vitest run --config vitest-integration.config.ts",
    "test:root:unit": "vitest run --config vitest.config.ts",
    "test:unit": "pnpm test:root:unit && turbo run test:unit",
    "typecheck": "pnpm typecheck:root && turbo run typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "website:build": "turbo run build --filter @moldea.ai/packages-website",
    "website:check": "pnpm --filter @moldea.ai/website-ui build && pnpm --filter @moldea.ai/packages-website check",
    "website:dev": "pnpm --filter @moldea.ai/website-ui build && pnpm --filter @moldea.ai/packages-website dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/semver": "7.8.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "semver": "7.8.5",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
