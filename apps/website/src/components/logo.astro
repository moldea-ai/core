---
import { withBase } from '../lib/site/url.ts';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a
  class="inline-flex min-w-0 items-center gap-3 rounded-md"
  href={withBase('/')}
  aria-label="moldea packages home"
>
  <img
    class="hidden h-8 w-auto dark:block"
    src={withBase(compact ? '/logo/icon-dark.png' : '/logo/logo-dark.png')}
    width={compact ? 185 : 942}
    height="210"
    alt=""
  />
  <img
    class="h-8 w-auto dark:hidden"
    src={withBase(compact ? '/logo/icon-light.png' : '/logo/logo-light.png')}
    width={compact ? 185 : 942}
    height="210"
    alt=""
  />
  <span
    class="hidden border-s border-border ps-3 text-xs font-semibold text-muted-foreground sm:inline"
    >packages</span
  >
</a>
