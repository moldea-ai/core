---
import BrandLogo from '@moldea.ai/website-ui/brand-logo';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<BrandLogo
  basePath={import.meta.env.BASE_URL}
  {compact}
  darkCompactLogoPath="/logo/icon-dark.png"
  darkLogoPath="/logo/logo-dark.png"
  homeLabel="moldea packages home"
  lightCompactLogoPath="/logo/icon-light.png"
  lightLogoPath="/logo/logo-light.png"
  suffix="packages"
/>
