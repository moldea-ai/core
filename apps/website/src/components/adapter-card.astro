---
import { ArrowUpRight } from '@lucide/astro';
import { withBase } from '@moldea.ai/website-ui/site';

import type { IAdapterPage } from '../lib/model/types.ts';
import AdapterCompanyLogo from './adapter-company-logo.astro';
import StatusBadge from './status-badge.astro';

interface Props {
  adapter: IAdapterPage;
}

const { adapter } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const target = adapter.entry.targets?.[0];
---

<a
  class="surface-card interactive-card group flex min-h-60 flex-col p-6"
  href={withBase(adapter.route, basePath)}
>
  <div class="mb-7 flex items-start justify-between gap-3">
    <AdapterCompanyLogo adapterId={adapter.id} />
    <ArrowUpRight
      class="size-5 text-muted-foreground transition-colors group-hover:text-foreground"
      aria-hidden="true"
    />
  </div>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <StatusBadge kind={adapter.entry.implementationStatus} />
    {target && <StatusBadge kind={target.supportLevel} />}
  </div>
  <h3 class="mb-2 text-xl font-semibold tracking-tight">{adapter.id}</h3>
  <p class="text-sm leading-6 text-muted-foreground">
    {
      adapter.entry.implementation.kind === 'built-in'
        ? `Built into ${adapter.entry.implementation.package}`
        : adapter.entry.implementation.package
    }
  </p>
  <span class="mt-auto pt-6 text-sm font-bold"
    >View compatibility <span aria-hidden="true">→</span></span
  >
</a>
