---
import { ArrowUpRight, Box, Database, FolderTree, LayoutTemplate, Terminal } from '@lucide/astro';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import type { IPublicPackage } from '../lib/model/types.ts';
import AdapterCompanyLogo from './adapter-company-logo.astro';

interface Props {
  adapterId?: string;
  packageModel: IPublicPackage;
}

const { adapterId, packageModel } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const icons = {
  cli: Terminal,
  core: Box,
  repository: Database,
  'repository-fs': FolderTree,
  'website-ui': LayoutTemplate,
} as const;
const Icon = icons[packageModel.slug as keyof typeof icons] ?? Box;
---

<a
  class="surface-card interactive-card group flex min-h-64 flex-col p-6"
  href={withBase(packageModel.route, basePath)}
>
  <div class="mb-8 flex items-start justify-between gap-4">
    {
      adapterId ? (
        <AdapterCompanyLogo {adapterId} />
      ) : (
        <span class="inline-flex size-11 items-center justify-center rounded-lg border bg-muted">
          <Icon
            class="size-5"
            aria-hidden="true"
          />
        </span>
      )
    }
    <ArrowUpRight
      class="size-5 text-muted-foreground transition-colors group-hover:text-foreground"
      aria-hidden="true"
    />
  </div>
  <p class="mb-2 font-mono text-xs text-muted-foreground">v{packageModel.version}</p>
  <h3 class="mb-3 text-xl font-semibold tracking-tight break-all">{packageModel.name}</h3>
  <p class="mb-6 leading-6 text-muted-foreground">
    <InlineBrandText text={packageModel.description} />
  </p>
  <span class="mt-auto text-sm font-bold">Explore package <span aria-hidden="true">→</span></span>
</a>
