---
import { Moon, Sun } from '@lucide/astro';
---

<button
  class="inline-flex size-10 items-center justify-center rounded-lg transition-colors hover:bg-secondary active:translate-y-px max-md:size-11"
  type="button"
  data-theme-control
  aria-label="Use dark theme"
  title="Use dark theme"
>
  <Moon
    class="theme-use-dark-icon size-4"
    aria-hidden="true"
  />
  <Sun
    class="theme-use-light-icon hidden size-4"
    aria-hidden="true"
  />
</button>

<script>
  import { isDarkTheme, parseThemePreference, type IThemePreference } from '../lib/theme/theme.ts';

  const THEME_STORAGE_KEY = 'moldea-website-theme';

  const applyTheme = (preference: IThemePreference): void => {
    const isDark = isDarkTheme(
      preference,
      window.matchMedia('(prefers-color-scheme: dark)').matches,
    );

    document.documentElement.classList.toggle('dark', isDark);
    document.documentElement.dataset.theme = preference;
    document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';

    const label = isDark ? 'Use light theme' : 'Use dark theme';

    for (const control of document.querySelectorAll<HTMLButtonElement>('[data-theme-control]')) {
      control.dataset.nextTheme = isDark ? 'light' : 'dark';
      control.setAttribute('aria-label', label);
      control.title = label;
    }
  };

  const initialPreference = parseThemePreference(localStorage.getItem(THEME_STORAGE_KEY));

  applyTheme(initialPreference);

  document.addEventListener('click', (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const control = target.closest<HTMLButtonElement>('[data-theme-control]');

    if (!control) return;

    const preference = control.dataset.nextTheme === 'light' ? 'light' : 'dark';
    localStorage.setItem(THEME_STORAGE_KEY, preference);
    applyTheme(preference);
  });

  document.addEventListener('astro:page-load', () => {
    applyTheme(parseThemePreference(localStorage.getItem(THEME_STORAGE_KEY)));
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (document.documentElement.dataset.theme === 'system') applyTheme('system');
  });
</script>

<style>
  :global(html.dark) .theme-use-dark-icon {
    display: none;
  }

  :global(html.dark) .theme-use-light-icon {
    display: block;
  }
</style>
