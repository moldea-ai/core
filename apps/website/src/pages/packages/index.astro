---
import PackageCard from '../../components/package-card.astro';
import Breadcrumbs from '../../components/breadcrumbs.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';

const model = loadWebsiteModel();
const toolingPackages = model.packages.filter(({ family }) => family === 'skill-core-tooling');
const adapterPackages = model.packages.filter(({ family }) => family === 'runtime-adapters');
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Packages' }];
---

<BaseLayout
  title="Open-source packages"
  description="Explore the public moldea packages for repository access, deterministic Core interpretation, CLI composition, and runtime adapters."
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <div class="max-w-4xl pt-16 pb-12">
      <p class="eyebrow mb-5">Public package ecosystem</p>
      <h1 class="section-title font-semibold">One foundation. Explicit responsibilities.</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-muted-foreground">
        Public package identity comes from implemented first-class projects. Private workspaces and
        planned adapter catalog entries are never promoted into this inventory by presentation code.
      </p>
    </div>

    <section aria-labelledby="tooling-title">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3">Package family</p>
          <h2
            id="tooling-title"
            class="text-3xl font-semibold tracking-tight"
          >
            Skill & Core Tooling
          </h2>
        </div>
        <p class="max-w-lg text-sm leading-6 text-muted-foreground">
          Source access, filesystem snapshots, repository interpretation, and local composition
          beneath the Agent Skill.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {toolingPackages.map((packageModel) => <PackageCard packageModel={packageModel} />)}
      </div>
    </section>

    <section
      class="mt-section-gap"
      aria-labelledby="adapter-packages-title"
    >
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-3">Package family</p>
          <h2
            id="adapter-packages-title"
            class="text-3xl font-semibold tracking-tight"
          >
            Runtime Adapters
          </h2>
        </div>
        <p class="max-w-lg text-sm leading-6 text-muted-foreground">
          Only implemented public adapter packages appear here. The complete official adapter
          inventory, including planned work and Core's built-in custom runtime, lives under
          Adapters.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {adapterPackages.map((packageModel) => <PackageCard packageModel={packageModel} />)}
      </div>
    </section>
  </section>
</BaseLayout>
