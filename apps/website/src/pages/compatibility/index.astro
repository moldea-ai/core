---
import Breadcrumbs from '@moldea.ai/website-ui/breadcrumbs';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterDetails from '../../components/adapter-details.astro';
import AdapterCompanyLogo from '../../components/adapter-company-logo.astro';
import StatusBadge from '../../components/status-badge.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { loadWebsiteModel } from '../../lib/generation/generation.ts';

const model = loadWebsiteModel();
const breadcrumbs = [{ href: '/', label: 'Home' }, { label: 'Runtime Compatibility' }];
const basePath = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Runtime compatibility"
  description="The complete canonical-matrix-driven view of moldea runtime adapter implementation status, target maturity, binding support, patterns, and limitations."
  {breadcrumbs}
>
  <section class="page-shell pt-8 pb-section-gap">
    <Breadcrumbs items={breadcrumbs} />
    <div class="max-w-4xl pt-16 pb-12">
      <p class="eyebrow mb-5">Canonical compatibility</p>
      <h1 class="section-title font-semibold">Claims backed by verified repository data.</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-muted-foreground">
        This page is generated from <code
          class="rounded bg-code px-1.5 py-1 font-mono text-sm text-code-foreground"
          >compatibility/runtimes.yaml</code
        > through the repository's strict parser. Omitted fields stay omitted; planned adapters do not
        inherit target details.
      </p>
    </div>

    <div class="table-scroll">
      <table class="w-full min-w-[54rem] text-sm">
        <caption class="sr-only">Official moldea runtime adapter compatibility summary</caption>
        <thead class="bg-muted">
          <tr>
            <th class="px-4 py-3 text-start">Adapter</th>
            <th class="px-4 py-3 text-start">Implementation status</th>
            <th class="px-4 py-3 text-start">Kind</th>
            <th class="px-4 py-3 text-start">Target maturity</th>
            <th class="px-4 py-3 text-start">Verified</th>
          </tr>
        </thead>
        <tbody>
          {
            model.adapters.map((adapter) => (
              <tr class="border-t">
                <th class="px-4 py-3 text-start font-mono">
                  <a
                    class="inline-flex items-center gap-3 hover:underline"
                    href={withBase(adapter.route, basePath)}
                  >
                    <AdapterCompanyLogo
                      adapterId={adapter.id}
                      compact
                    />
                    <span>{adapter.id}</span>
                  </a>
                </th>
                <td class="px-4 py-3">
                  <StatusBadge kind={adapter.entry.implementationStatus} />
                </td>
                <td class="px-4 py-3">{adapter.entry.implementation.kind}</td>
                <td class="px-4 py-3">
                  {adapter.entry.targets?.length
                    ? [
                        ...new Set(adapter.entry.targets.map(({ supportLevel }) => supportLevel)),
                      ].map((supportLevel) => (
                        <span class="me-2 inline-flex">
                          <StatusBadge kind={supportLevel} />
                        </span>
                      ))
                    : 'Not available'}
                </td>
                <td class="px-4 py-3">{adapter.entry.lastVerifiedAt ?? 'Not available'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 mb-section-gap text-xs leading-5 text-muted-foreground">
      Company names and marks belong to their respective owners. Compatibility does not imply
      endorsement.
    </p>

    <div class="space-y-5">
      {
        model.adapters.map((adapter) => (
          <details class="surface-card group">
            <summary class="flex min-h-16 list-none items-center justify-between gap-4 px-5 font-semibold [&::-webkit-details-marker]:hidden">
              <span class="inline-flex min-w-0 items-center gap-3">
                <AdapterCompanyLogo
                  adapterId={adapter.id}
                  compact
                />
                <span class="min-w-0 font-mono break-words">{adapter.id}</span>
              </span>
              <span class="shrink-0 text-sm text-muted-foreground group-open:hidden">
                Show details
              </span>
              <span class="hidden shrink-0 text-sm text-muted-foreground group-open:inline">
                Hide details
              </span>
            </summary>
            <div class="border-t border-border p-5 sm:p-7">
              <AdapterDetails
                {adapter}
                compact
              />
            </div>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
