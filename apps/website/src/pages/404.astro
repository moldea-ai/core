---
import { ArrowLeft } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import { withBase } from '@moldea.ai/website-ui/site';

import BaseLayout from '../layouts/base-layout.astro';

const basePath = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found"
  description="The requested moldea packages documentation page could not be found."
  noIndex
>
  <section class="page-shell flex min-h-[65vh] items-center py-section-gap">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5">404 · Page not found</p>
      <h1 class="section-title font-semibold">This route is outside the snapshot.</h1>
      <p class="mt-7 max-w-2xl text-xl leading-9 text-muted-foreground">
        The documentation may have moved, or the address may not identify a generated public route.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <ActionLink
          href={withBase('/', basePath)}
          size="lg"
        >
          <ArrowLeft
            class="size-4"
            aria-hidden="true"
          /> Back to packages
        </ActionLink>
        <ActionLink
          href={withBase('/search/', basePath)}
          size="lg"
          variant="outline"
        >
          Search documentation
        </ActionLink>
      </div>
    </div>
  </section>
</BaseLayout>
