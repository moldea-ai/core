---
import { ArrowRight, GitFork, Layers, ShieldCheck, Workflow } from '@lucide/astro';
import ActionLink from '@moldea.ai/website-ui/action-link';
import InlineBrandText from '@moldea.ai/website-ui/inline-brand-text';
import { withBase } from '@moldea.ai/website-ui/site';

import AdapterCard from '../components/adapter-card.astro';
import PackageCard from '../components/package-card.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { loadWebsiteModel } from '../lib/generation/generation.ts';

const model = loadWebsiteModel();
const toolingPackages = model.packages.filter(({ family }) => family === 'skill-core-tooling');
const adapterPackages = model.packages.filter(({ family }) => family === 'runtime-adapters');
const availableAdapters = model.adapters.filter(
  ({ entry }) => entry.implementationStatus === 'available',
);
const cliPackage = model.packages.find(({ slug }) => slug === 'cli');
const basePath = import.meta.env.BASE_URL;
---

<BaseLayout
  title="moldea packages"
  description="The open-source deterministic package foundation that powers moldea, the behavioral integrity layer for AI agents."
>
  <section class="relative overflow-hidden border-b border-border">
    <div
      class="pointer-events-none absolute inset-0 [background-image:radial-gradient(circle_at_70%_18%,color-mix(in_oklch,var(--accent)_60%,transparent),transparent_30%),linear-gradient(to_right,color-mix(in_oklch,var(--border)_35%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_oklch,var(--border)_35%,transparent)_1px,transparent_1px)] [mask-image:linear-gradient(to_bottom,black,transparent_92%)] [background-size:auto,3rem_3rem,3rem_3rem] opacity-60"
      aria-hidden="true"
    >
    </div>
    <div class="page-shell relative pt-16 pb-20 sm:pt-24 sm:pb-24 lg:pt-32 lg:pb-32">
      <p class="eyebrow mb-8">Open-source technical foundation</p>
      <h1 class="display-title max-w-6xl font-semibold">
        Behavioral integrity,<br />built in the open.
      </h1>
      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
        <p class="max-w-3xl text-xl leading-9 text-muted-foreground sm:text-2xl">
          <InlineBrandText
            text="moldea is the behavioral integrity layer for AI agents. This repository provides the deterministic readers, repository interpretation, local CLI, and runtime adapters that make its behavior inspectable."
          />
        </p>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <ActionLink
            href={withBase('/packages/', basePath)}
            size="lg"
          >
            Explore packages <ArrowRight
              class="size-4"
              aria-hidden="true"
            />
          </ActionLink>
          <ActionLink
            href="https://github.com/moldea-ai/packages"
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
          >
            <GitFork
              class="size-4"
              aria-hidden="true"
            /> Source
          </ActionLink>
        </div>
      </div>
    </div>
  </section>

  <section
    class="page-shell py-section-gap"
    aria-labelledby="architecture-title"
  >
    <div class="mb-10 grid gap-5 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow mb-4">One directional architecture</p>
        <h2
          id="architecture-title"
          class="section-title max-w-3xl font-semibold"
        >
          From source bytes to trusted structure.
        </h2>
      </div>
      <p class="max-w-xl leading-7 text-muted-foreground lg:justify-self-end">
        Repository readers preserve exact source state, Core turns it into deterministic project
        structure, and runtime adapters add source-grounded evidence. The Agent Skill consumes that
        foundation as its semantic operating layer; package contracts never depend back on the skill
        or this website.
      </p>
    </div>

    <div class="surface-card overflow-hidden p-4 sm:p-6 lg:p-8">
      <div class="grid gap-3 lg:grid-cols-[1fr_auto_1fr] lg:items-center">
        <div class="rounded-xl bg-primary p-6 text-primary-foreground">
          <Workflow
            class="mb-8 size-6"
            aria-hidden="true"
          />
          <p class="eyebrow mb-2 text-current/65">Semantic operating layer</p>
          <h3 class="text-2xl font-semibold">Agent Skill</h3>
          <p class="mt-2 text-sm leading-6 text-current/70">
            Adoption, workflows, tutorials, and agent interaction live separately.
          </p>
        </div>
        <ArrowRight
          class="mx-auto hidden size-5 lg:block"
          aria-hidden="true"
        />
        <div class="rounded-xl border bg-accent p-6 text-accent-foreground">
          <Layers
            class="mb-8 size-6"
            aria-hidden="true"
          />
          <p class="eyebrow mb-2">Local composition</p>
          <h3 class="text-2xl font-semibold">{cliPackage?.name}</h3>
          <p class="mt-2 text-sm leading-6">
            Git-aware inventory composes Repository FS, Core, and active runtime adapters.
          </p>
        </div>
      </div>

      <div
        class="my-4 flex justify-center"
        aria-hidden="true"
      >
        <span class="h-7 w-px bg-border"></span>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          toolingPackages
            .filter(({ slug }) => slug !== 'cli')
            .map((packageModel) => (
              <a
                class="interactive-card rounded-xl border bg-muted/60 p-5 hover:bg-muted"
                href={withBase(packageModel.route, basePath)}
              >
                <p class="mb-5 font-mono text-xs text-muted-foreground">{packageModel.name}</p>
                <p class="text-sm leading-6">
                  <InlineBrandText text={packageModel.description} />
                </p>
              </a>
            ))
        }
        {
          adapterPackages.map((packageModel) => (
            <a
              class="interactive-card rounded-xl border bg-muted/60 p-5 hover:bg-muted"
              href={withBase(packageModel.route, basePath)}
            >
              <p class="mb-5 font-mono text-xs text-muted-foreground">{packageModel.name}</p>
              <p class="text-sm leading-6">Runtime-specific evidence flows into Core.</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y bg-sidebar py-section-gap">
    <div class="page-shell">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow mb-4">Skill & Core Tooling</p>
          <h2 class="section-title font-semibold">Deterministic by design.</h2>
        </div>
        <ActionLink
          class="font-bold"
          href={withBase('/packages/', basePath)}
          variant="link"
        >
          View all packages <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {toolingPackages.map((packageModel) => <PackageCard packageModel={packageModel} />)}
      </div>
    </div>
  </section>

  <section
    class="page-shell py-section-gap"
    aria-labelledby="available-adapters-title"
  >
    <div class="mb-10 grid gap-5 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow mb-4">Available runtime adapters</p>
        <h2
          id="available-adapters-title"
          class="section-title max-w-4xl font-semibold"
        >
          Runtime-specific evidence, built in.
        </h2>
      </div>
      <div class="max-w-xl lg:justify-self-end">
        <p class="leading-7 text-muted-foreground">
          Official adapters add source-grounded runtime interpretation to Core without executing
          application code. Available package-backed adapters and Core's built-in custom runtime
          come directly from the compatibility matrix.
        </p>
        <ActionLink
          class="mt-5 font-bold"
          href={withBase('/adapters/', basePath)}
          variant="link"
        >
          View all adapters <ArrowRight
            class="size-4"
            aria-hidden="true"
          />
        </ActionLink>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {availableAdapters.map((adapter) => <AdapterCard {adapter} />)}
    </div>
    <p class="mt-5 text-xs leading-5 text-muted-foreground">
      Company names and marks belong to their respective owners. Compatibility does not imply
      endorsement.
    </p>
  </section>

  <section class="border-t border-border">
    <div class="page-shell py-section-gap">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_25rem] lg:items-center">
        <div>
          <ShieldCheck
            class="mb-7 size-9 text-foreground"
            aria-hidden="true"
          />
          <p class="eyebrow mb-4">Compatibility without guesswork</p>
          <h2 class="section-title max-w-4xl font-semibold">
            Every runtime claim comes from one matrix.
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
            Available, planned, experimental, supported, ambiguous, and unsupported remain distinct.
            A specification does not become a compatibility claim until the canonical matrix says
            so.
          </p>
        </div>
        <div class="surface-card grid gap-3 p-5">
          <a
            class="interactive-card rounded-lg border p-4 font-semibold hover:bg-muted"
            href={withBase('/adapters/', basePath)}
          >
            Runtime adapter inventory <span
              class="float-end"
              aria-hidden="true"
              >→</span
            >
          </a>
          <a
            class="interactive-card rounded-lg border p-4 font-semibold hover:bg-muted"
            href={withBase('/compatibility/', basePath)}
          >
            Complete compatibility matrix <span
              class="float-end"
              aria-hidden="true"
              >→</span
            >
          </a>
          <a
            class="interactive-card rounded-lg border p-4 font-semibold hover:bg-muted"
            href={withBase('/llms.txt', basePath)}
          >
            Machine-oriented ecosystem map <span
              class="float-end"
              aria-hidden="true"
              >→</span
            >
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
