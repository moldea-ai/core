{
  "name": "@moldea.ai/packages-website",
  "version": "0.0.0",
  "description": "The private static documentation application for the open moldea packages ecosystem.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate.ts && astro build && node scripts/verify-build.ts",
    "check:links": "node scripts/verify-build.ts",
    "check": "pnpm docs:check && pnpm test:unit && pnpm typecheck && pnpm lint && pnpm build && pnpm test:integration",
    "dev": "node scripts/generate.ts && astro dev",
    "docs:check": "node scripts/check.ts",
    "docs:generate": "node scripts/generate.ts",
    "lint": "eslint astro.config.ts playwright.config.ts scripts src vitest",
    "preview": "vite preview --base / --host 127.0.0.1 --port 4321 --strictPort",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest/test-integration.config.ts",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "typecheck": "node scripts/generate.ts && astro check"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/ubuntu-sans": "5.2.10",
    "@lucide/astro": "1.31.0",
    "@playwright/test": "1.62.1",
    "@shikijs/rehype": "4.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "astro": "7.2.2",
    "eslint": "10.8.1",
    "parse5": "8.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  }
}
