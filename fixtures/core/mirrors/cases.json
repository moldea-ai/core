    {
      "name": "missing, wrong-type, symlink, and stale mirrors",
      "manifest": "version: 1\nagents:\n  alpha:\n    runtime:\n      id: custom\n    mirrors:\n      - /mirrors/f-empty.md\n      - /mirrors/e-stale-unicode.md\n      - /mirrors/d-stale-space.md\n      - /mirrors/c-link.md\n      - /mirrors/b-directory\n      - /mirrors/a-missing.md\n",
      "entries": [
        {
          "path": "/moldea/agents/alpha/description.md",
          "type": "file",
          "text": "Alpha agent.\n"
        },
        {
          "path": "/moldea/agents/alpha/instruction.md",
          "type": "file",
          "text": "You are the `alpha` agent.\nHandle café requests.\n"
