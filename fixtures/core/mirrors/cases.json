{
  "cases": [
    {
      "name": "normalized matching mirrors",
      "manifest": "version: 1\nagents:\n  zeta:\n    runtime:\n      id: custom\n    mirrors:\n      - /apps/zeta.md\n  alpha:\n    runtime:\n      id: custom\n    mirrors:\n      - /apps/alpha-crlf.md\n      - /apps/alpha-cr.md\n",
      "entries": [
        {
          "path": "/moldea/agents/zeta/description.md",
          "type": "file",
          "text": "Zeta agent.\n"
        },
        {
          "path": "/moldea/agents/zeta/instruction.md",
          "type": "file",
          "text": "You are the `zeta` agent.\n"
        },
        {
          "path": "/moldea/agents/alpha/description.md",
          "type": "file",
          "text": "Alpha agent.\n"
        },
        {
          "path": "/moldea/agents/alpha/instruction.md",
          "type": "file",
          "text": "You are the `alpha` agent.\nHandle café requests.\n"
        },
        {
          "path": "/apps/zeta.md",
          "type": "file",
          "text": "You are the `zeta` agent.\r"
        },
        {
          "path": "/apps/alpha-crlf.md",
          "type": "file",
          "text": "﻿You are the `alpha` agent.\r\nHandle café requests.\r\n"
        },
        {
          "path": "/apps/alpha-cr.md",
          "type": "file",
          "text": "You are the `alpha` agent.\rHandle café requests.\r"
        }
      ],
      "expectedAgentMirrors": [
        {
          "id": "alpha",
          "mirrors": [
            {
              "path": "/apps/alpha-cr.md",
              "digest": "sha256:26d3cbfcfc24d9661a8f7e602630d6eeefb5a5efeed7e3b3b9a668367f840ba7",
              "canonicalDigest": "sha256:26d3cbfcfc24d9661a8f7e602630d6eeefb5a5efeed7e3b3b9a668367f840ba7"
            },
            {
              "path": "/apps/alpha-crlf.md",
