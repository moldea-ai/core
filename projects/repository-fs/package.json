{
  "name": "@moldea.ai/repository-fs",
  "version": "1.0.0",
  "description": "A coherent, read-only repository reader over an explicitly selected local filesystem root.",
  "homepage": "https://github.com/moldea-ai/packages/tree/main/projects/repository-fs#readme",
  "bugs": {
    "url": "https://github.com/moldea-ai/packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moldea-ai/packages.git",
    "directory": "projects/repository-fs"
  },
  "license": "MIT",
  "author": "Jesus Graterol",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^22.11.0 || ^24.11.0"
  },
  "scripts": {
    "build": "vite build --emptyOutDir && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:integration": "pnpm run build && vitest run --config vitest/test-integration.config.ts",
    "test:unit": "vitest run --config vitest/test-unit.config.ts",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@moldea.ai/repository": "workspace:^1.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "web-utils-kit": "1.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
